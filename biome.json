{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"ignore": [
      "./node_modules/**",
      "./.next/**",
      "./.vercel/**",
      "./build/**",
      "./services/forem/**"
    ]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
    "ignore": [
      "./services/forem/**/*.ts",
      "./node_modules"
    ]
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
      "suspicious": {
        "noExplicitAny": "off"
      }
		},
    "ignore": [
      "./services/forem/**/*.ts",
      "./node_modules"
    ]
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
